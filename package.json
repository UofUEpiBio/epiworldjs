{
  "name": "epiworldjs",
  "version": "0.18.0-0",
  "description": "Run epiworld's agent-based epidemic models in the browser (and Node) via WebAssembly, with a drop-in <epiworld-model> web component.",
  "keywords": [
    "epidemiology",
    "agent-based model",
    "simulation",
    "webassembly",
    "wasm",
    "epiworld",
    "web component",
    "measles",
    "sir",
    "seir"
  ],
  "homepage": "https://uofuepibio.github.io/epiworldjs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UofUEpiBio/epiworldjs.git"
  },
  "bugs": {
    "url": "https://github.com/UofUEpiBio/epiworldjs/issues"
  },
  "author": "George G. Vega Yon (https://github.com/gvegayon)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./element": "./src/element.js",
    "./dist/epiworld-model.js": "./dist/epiworld-model.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "vendor/epiworld/LICENSE.md",
    "vendor/measles/LICENSE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "make wasm",
    "test": "make test",
    "e2e": "playwright test",
    "serve": "node test/e2e/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
